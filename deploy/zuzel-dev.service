[Unit]
Description=Zuzel dev/staging (zuzel-dev.hpkgrupa.pl) — osobny checkout, branch develop
After=network.target

[Service]
Type=simple
# Produkcja operatora: User=deploy + ~/projects/zuzel-dev
# Dedykowany dev SSH: User=zuzeldev, WorkingDirectory=/home/zuzeldev/zuzel (patrz docs/deploy-staging-dedicated-ssh-user.md)
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/projects/zuzel-dev
Environment=NODE_ENV=production
Environment=PORT=3083
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
