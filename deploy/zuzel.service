[Unit]
Description=Zuzel multiplayer speedway game (zuzel.hpkgrupa.pl)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/projects/zuzel
Environment=NODE_ENV=production
Environment=PORT=3080
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
